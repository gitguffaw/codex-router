{
  "name": "@compound/codex-router-plugin-cc",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Route Claude Code and AGY work through Codex with live model discovery, policy-backed modes, and reliable job handling.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/gitguffaw/codex-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitguffaw/codex-router.git"
  },
  "bugs": {
    "url": "https://github.com/gitguffaw/codex-router/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "agy",
    "antigravity",
    "models",
    "plugin",
    "review",
    "delegation"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "mkdir -p plugins/codex-router/.generated/app-server-types && codex app-server generate-ts --out plugins/codex-router/.generated/app-server-types",
    "build": "tsc -p tsconfig.app-server.json",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^6.0.2"
  }
}
